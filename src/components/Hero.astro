---
// Fallback until /dl/manifest.json arrives (or if it never does).
const defaultWindowsUrl = "/dl/RustDesk-win64.exe";
---

<section class="hero-section">
  <div class="container hero-container">
    <div class="hero-badge">
      <span class="pulse-dot"></span>
      <span data-i18n-es>davepinto.dev · Escritorio Remoto</span>
      <span data-i18n-en>davepinto.dev · Remote Desktop</span>
    </div>

    <h1 class="hero-title">
      <span data-i18n-es>Soporte remoto rápido y seguro.</span>
      <span data-i18n-en>Fast, secure remote support.</span>
    </h1>

    <p class="hero-subtitle">
      <span data-i18n-es>
        Descarga el cliente de RustDesk para conectarte directamente al servidor personal sin necesidad de configuraciones complicadas.
      </span>
      <span data-i18n-en>
        Download the RustDesk client to connect directly to the personal server with zero manual setup.
      </span>
    </p>

    <!-- Shown instead of the download button on phones, tablets and Linux/other systems -->
    <div class="platform-note hidden" id="note-mobile" role="note">
      <span data-i18n-es>
        Estás en un teléfono o tableta. Estos clientes son para computadoras: abre esta página en tu computadora con Windows o Mac.
      </span>
      <span data-i18n-en>
        You're on a phone or tablet. These clients are for computers: open this page on your Windows or Mac computer.
      </span>
    </div>
    <div class="platform-note hidden" id="note-other" role="note">
      <span data-i18n-es>
        Solo hay clientes preconfigurados para Windows y macOS. Si lo descargas para otra computadora, elige su sistema abajo.
      </span>
      <span data-i18n-en>
        Preconfigured clients are only available for Windows and macOS. If you're downloading for another computer, pick its system below.
      </span>
    </div>

    <!-- Primary Download Area -->
    <div class="download-action" id="download-action">
      <a
        id="primary-download-btn"
        href={defaultWindowsUrl}
        class="btn-primary hero-btn"
        download
      >
        <svg
          class="download-icon"
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        <span class="btn-label">
          <span data-i18n-es id="primary-btn-label-es">Descargar para Windows</span>
          <span data-i18n-en id="primary-btn-label-en">Download for Windows</span>
        </span>
        <span id="primary-btn-size" class="btn-meta"></span>
      </a>

      <div class="os-detected-note" id="os-detected-label">
        <span data-i18n-es id="os-note-es"></span>
        <span data-i18n-en id="os-note-en"></span>
      </div>

      <!-- Offered on Macs: Safari cannot tell Apple Silicon from Intel, so let the visitor switch -->
      <button type="button" class="alt-mac hidden" id="alt-mac-btn">
        <span data-i18n-es id="alt-mac-es"></span>
        <span data-i18n-en id="alt-mac-en"></span>
      </button>
    </div>

    <!-- "Not your system?" selector row -->
    <div class="other-platforms">
      <span class="other-label" data-i18n-es>¿Otro sistema operativo?</span>
      <span class="other-label" data-i18n-en>Not your system?</span>
      <div class="platform-chips" role="group" aria-label="Operating system / Sistema operativo">
        <button type="button" class="chip-btn" data-target-os="windows" aria-pressed="false">
          Windows
        </button>
        <button type="button" class="chip-btn" data-target-os="mac_arm64" aria-pressed="false">
          macOS (Apple Silicon)
        </button>
        <button type="button" class="chip-btn" data-target-os="mac_intel" aria-pressed="false">
          macOS (Intel)
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding: 4.5rem 0 3rem;
    text-align: center;
  }

  .hero-container {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3125rem 0.75rem;
    border-radius: 9999px;
    background-color: var(--badge-bg);
    color: var(--badge-text);
    border: 1px solid var(--badge-border);
    font-size: 0.8125rem;
    font-weight: 500;
    margin-bottom: 1.5rem;
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--accent);
    display: inline-block;
  }

  .hero-title {
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.15;
    color: var(--text);
    max-width: 680px;
    margin-bottom: 1.25rem;
  }

  .hero-subtitle {
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 620px;
    margin-bottom: 2.5rem;
  }

  .download-action {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 2.25rem;
  }

  .hero-btn {
    padding: 0.875rem 2rem;
    font-size: 1.0625rem;
    border-radius: 10px;
    font-weight: 500;
    cursor: pointer;
    flex-wrap: wrap;
    row-gap: 0.125rem;
    max-width: 100%;
    text-align: center;
  }

  .btn-label {
    text-wrap: balance;
  }

  .btn-meta {
    opacity: 0.85;
    font-size: 0.9375rem;
    font-weight: 400;
    margin-left: 0.25rem;
    white-space: nowrap;
  }

  .download-icon {
    flex-shrink: 0;
  }

  .os-detected-note {
    font-size: 0.8125rem;
    color: var(--text-muted);
    min-height: 1.25em;
  }

  .alt-mac {
    font-size: 0.8125rem;
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    padding: 0.125rem 0.25rem;
    border-radius: 4px;
  }

  .alt-mac:hover {
    color: var(--accent-hover);
  }

  .platform-note {
    max-width: 560px;
    margin-bottom: 1.75rem;
    padding: 0.875rem 1rem;
    border-radius: 10px;
    background-color: var(--badge-bg);
    border: 1px solid var(--badge-border);
    color: var(--badge-text);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .hidden {
    display: none !important;
  }

  .other-platforms {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--text-muted);
    padding-top: 0.5rem;
  }

  .other-label {
    margin-right: 0.25rem;
  }

  .platform-chips {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.25rem 0.5rem;
  }

  @media (max-width: 480px) {
    .hero-section {
      padding-top: 3rem;
    }

    .hero-btn {
      width: 100%;
      padding: 0.875rem 1.25rem;
    }

    .other-platforms {
      flex-direction: column;
      gap: 0.375rem;
    }

    .other-label {
      margin-right: 0;
    }
  }

  .chip-btn {
    color: var(--text-secondary);
    padding: 0.25rem 0.5rem;
    border-radius: 6px;
    font-size: 0.875rem;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .chip-btn:hover {
    color: var(--text);
    background-color: var(--surface-hover);
  }

  .chip-btn[aria-pressed="true"] {
    color: var(--accent);
    font-weight: 600;
    background-color: var(--badge-bg);
  }
</style>

<script>
  type Os = 'windows' | 'mac_arm64' | 'mac_intel';

  interface ManifestItem {
    url?: unknown;
    size?: unknown;
    sha256?: unknown;
    version?: unknown;
  }

  type Manifest = Partial<Record<Os, ManifestItem>> & Record<string, unknown>;

  const NAMES: Record<Os, string> = {
    windows: 'Windows',
    mac_arm64: 'macOS (Apple Silicon)',
    mac_intel: 'macOS (Intel)',
  };

  const DEFAULT_URLS: Record<Os, string> = {
    windows: '/dl/RustDesk-win64.exe',
    mac_arm64: '/dl/RustDesk-mac-arm64.dmg',
    mac_intel: '/dl/RustDesk-mac-intel.dmg',
  };

  let manifest: Manifest | null = null;
  let current: Os = 'windows';
  let chosenByHand = false;

  // Only ever link to our own download host, whatever the manifest says.
  function safeUrl(url: unknown): string | undefined {
    if (typeof url !== 'string') return undefined;
    return url.startsWith('/dl/') || url.startsWith('https://dl.davepinto.dev/') ? url : undefined;
  }

  function setText(id: string, text: string) {
    const el = document.getElementById(id);
    if (el) el.textContent = text;
  }

  function render() {
    const name = NAMES[current];
    const item = manifest?.[current];

    const btn = document.getElementById('primary-download-btn') as HTMLAnchorElement | null;
    if (btn) btn.href = safeUrl(item?.url) || DEFAULT_URLS[current];

    setText('primary-btn-label-es', `Descargar para ${name}`);
    setText('primary-btn-label-en', `Download for ${name}`);

    const size = item?.size;
    setText('primary-btn-size', typeof size === 'number' && size > 0 ? `(${Math.round(size / 1e6)} MB)` : '');

    setText('os-note-es', chosenByHand ? `Seleccionado: ${name}` : `Detectado: ${name}`);
    setText('os-note-en', chosenByHand ? `Selected: ${name}` : `Detected: ${name}`);

    // On a Mac, offer the other architecture: the wrong DMG simply refuses to open.
    const alt = document.getElementById('alt-mac-btn');
    if (alt) {
      if (current === 'windows') {
        alt.classList.add('hidden');
      } else {
        const other: Os = current === 'mac_arm64' ? 'mac_intel' : 'mac_arm64';
        alt.dataset.targetOs = other;
        if (other === 'mac_intel') {
          setText('alt-mac-es', '¿Tu Mac tiene procesador Intel? Descarga la versión para Intel');
          setText('alt-mac-en', 'Mac with an Intel processor? Get the Intel version');
        } else {
          setText('alt-mac-es', '¿Tu Mac tiene chip Apple (M1 o posterior)? Descarga la versión para Apple Silicon');
          setText('alt-mac-en', 'Mac with an Apple chip (M1 or later)? Get the Apple Silicon version');
        }
        alt.classList.remove('hidden');
      }
    }

    document.querySelectorAll<HTMLButtonElement>('.chip-btn').forEach((chip) => {
      chip.setAttribute('aria-pressed', String(chip.dataset.targetOs === current));
    });

    document.documentElement.dataset.selectedOs = current;
    document.dispatchEvent(new CustomEvent('os-change', { detail: { os: current } }));
  }

  function select(os: Os, byHand: boolean) {
    current = os;
    chosenByHand = chosenByHand || byHand;
    if (byHand) {
      // Picking a system by hand overrides the phone/other notice.
      document.getElementById('download-action')?.classList.remove('hidden');
      document.getElementById('note-mobile')?.classList.add('hidden');
      document.getElementById('note-other')?.classList.add('hidden');
    }
    render();
  }

  // Single owner of the manifest fetch. Checksums and Footer listen for 'manifest-loaded'
  // (or read window.__MANIFEST__ if they initialise after it arrived).
  async function loadManifest() {
    try {
      const res = await fetch('/dl/manifest.json', { cache: 'no-store' });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = await res.json();
      if (!data || typeof data !== 'object') throw new Error('not an object');
      manifest = data as Manifest;
      (window as any).__MANIFEST__ = manifest;
      render();
      document.dispatchEvent(new CustomEvent('manifest-loaded', { detail: { manifest } }));
    } catch {
      document.dispatchEvent(new CustomEvent('manifest-failed'));
    }
  }

  // Chromium on macOS exposes the CPU architecture; Safari and Firefox do not.
  async function refineMacArch() {
    const uad = (navigator as any).userAgentData;
    // Only trust it when the same API also says macOS (a spoofed or mismatched UA says otherwise).
    if (!uad?.getHighEntropyValues || uad.platform !== 'macOS') return;
    try {
      const { architecture } = await uad.getHighEntropyValues(['architecture']);
      if (architecture === 'x86' && !chosenByHand && current === 'mac_arm64') {
        select('mac_intel', false);
      }
    } catch {
      // keep the default
    }
  }

  function initHero() {
    const platform = document.documentElement.dataset.os || 'other';

    if (platform === 'windows' || platform === 'mac_arm64') {
      current = platform;
    } else {
      document.getElementById('download-action')?.classList.add('hidden');
      document
        .getElementById(platform === 'ios' || platform === 'android' ? 'note-mobile' : 'note-other')
        ?.classList.remove('hidden');
      // Point the button at a sensible default in case the visitor picks a system by hand.
      current = platform === 'ios' ? 'mac_arm64' : 'windows';
    }

    render();
    loadManifest();
    if (platform === 'mac_arm64') refineMacArch();

    document.querySelectorAll<HTMLButtonElement>('.chip-btn, #alt-mac-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const os = btn.dataset.targetOs as Os | undefined;
        if (os && os in NAMES) select(os, true);
      });
    });
  }

  initHero();
</script>
