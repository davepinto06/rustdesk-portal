---
// Static fallback download items (version-less and stable URLs)
const FALLBACK_ITEMS = [
  {
    id: 'windows',
    file: 'RustDesk-win64.exe',
    url: '/dl/RustDesk-win64.exe',
    platformEs: 'Windows (x64)',
    platformEn: 'Windows (x64)'
  },
  {
    id: 'mac_arm64',
    file: 'RustDesk-mac-arm64.dmg',
    url: '/dl/RustDesk-mac-arm64.dmg',
    platformEs: 'macOS (Apple Silicon)',
    platformEn: 'macOS (Apple Silicon)'
  },
  {
    id: 'mac_intel',
    file: 'RustDesk-mac-intel.dmg',
    url: '/dl/RustDesk-mac-intel.dmg',
    platformEs: 'macOS (Intel)',
    platformEn: 'macOS (Intel)'
  }
];
---

<section class="checksums-section" id="checksums">
  <div class="container">
    <div class="checksums-card">
      <div class="checksums-header">
        <h3 class="checksums-title">
          <span data-i18n-es>Descargas directas y verificación</span>
          <span data-i18n-en>Direct Downloads & Verification</span>
        </h3>
        <p class="checksums-subtitle" id="checksums-subtitle">
          <span data-i18n-es>
            Enlaces directos a los instaladores. Las sumas de verificación SHA-256 se verifican automáticamente desde el servidor de descargas.
          </span>
          <span data-i18n-en>
            Direct links to client installers. SHA-256 verification checksums are loaded automatically from the download server.
          </span>
        </p>
      </div>

      <div class="checksums-table-wrapper">
        <table class="checksums-table" id="checksums-table">
          <thead>
            <tr>
              <th>
                <span data-i18n-es>Archivo</span>
                <span data-i18n-en>File</span>
              </th>
              <th>
                <span data-i18n-es>Plataforma</span>
                <span data-i18n-en>Platform</span>
              </th>
              <!-- Hash column is hidden until real hashes are fetched from /dl/manifest.json -->
              <th class="hash-col hidden" id="hash-col-header">
                <span data-i18n-es>Hash SHA-256</span>
                <span data-i18n-en>SHA-256 Hash</span>
              </th>
            </tr>
          </thead>
          <tbody>
            {FALLBACK_ITEMS.map((item) => (
              <tr>
                <td class="file-name">
                  <a href={item.url} class="download-table-link" id={`download-link-${item.id}`} download>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                      <polyline points="7 10 12 15 17 10"></polyline>
                      <line x1="12" y1="15" x2="12" y2="3"></line>
                    </svg>
                    <span>{item.file}</span>
                  </a>
                </td>
                <td>
                  <span data-i18n-es>{item.platformEs}</span>
                  <span data-i18n-en>{item.platformEn}</span>
                </td>
                <td class="hash-col hidden" id={`hash-val-${item.id}`}></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>

<style>
  .checksums-section {
    padding: 2.5rem 0 3.5rem;
  }

  .checksums-card {
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.5rem;
  }

  .checksums-header {
    margin-bottom: 1.25rem;
  }

  .checksums-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 0.25rem;
  }

  .checksums-subtitle {
    font-size: 0.8125rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .checksums-table-wrapper {
    overflow-x: auto;
  }

  .checksums-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.8125rem;
    text-align: left;
  }

  .checksums-table th {
    padding: 0.625rem 0.75rem;
    border-bottom: 1px solid var(--border);
    color: var(--text-muted);
    font-weight: 500;
    white-space: nowrap;
  }

  .checksums-table td {
    padding: 0.625rem 0.75rem;
    border-bottom: 1px solid var(--border-subtle);
    color: var(--text-secondary);
  }

  .checksums-table tr:last-child td {
    border-bottom: none;
  }

  .file-name {
    font-weight: 500;
    color: var(--text);
  }

  .download-table-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--accent);
    font-weight: 500;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .download-table-link:hover {
    text-decoration: underline;
    color: var(--accent-hover);
  }

  .hash-code {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-secondary);
    background-color: var(--code-bg);
    padding: 0.125rem 0.375rem;
    border-radius: 4px;
    word-break: break-all;
    display: inline-block;
  }

  .hidden {
    display: none !important;
  }
</style>

<script>
  function renderChecksums(manifest: any) {
    if (!manifest) return;

    let hasAnyHash = false;
    const items = ['windows', 'mac_arm64', 'mac_intel'];

    items.forEach(id => {
      const itemData = manifest[id];
      const hashCell = document.getElementById(`hash-val-${id}`);
      const linkEl = document.getElementById(`download-link-${id}`) as HTMLAnchorElement | null;

      if (itemData?.url && linkEl) {
        linkEl.href = itemData.url;
      }

      if (itemData?.sha256 && typeof itemData.sha256 === 'string' && itemData.sha256.trim() !== '') {
        hasAnyHash = true;
        if (hashCell) {
          hashCell.innerHTML = `<code class="hash-code">${itemData.sha256}</code>`;
        }
      }
    });

    if (hasAnyHash) {
      // Reveal hash column headers and cells
      document.querySelectorAll('.hash-col').forEach(el => {
        el.classList.remove('hidden');
      });
    }
  }

  // 1. Listen for manifest-loaded event
  document.addEventListener('manifest-loaded', ((e: CustomEvent) => {
    if (e.detail?.manifest) {
      renderChecksums(e.detail.manifest);
    }
  }) as EventListener);

  // 2. Direct fetch fallback if Hero has not dispatched yet
  async function fetchManifestDirectly() {
    try {
      const res = await fetch('/dl/manifest.json');
      if (res.ok) {
        const manifest = await res.json();
        renderChecksums(manifest);
      }
    } catch {
      // Keep hash column hidden, static fallback links remain visible
    }
  }

  fetchManifestDirectly();
</script>
