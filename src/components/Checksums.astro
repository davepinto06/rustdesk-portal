---
// Static fallback download items (version-less and stable URLs)
const FALLBACK_ITEMS = [
  {
    id: 'windows',
    file: 'RustDesk-win64.exe',
    url: '/dl/RustDesk-win64.exe',
    platformEs: 'Windows (x64)',
    platformEn: 'Windows (x64)'
  },
  {
    id: 'mac_arm64',
    file: 'RustDesk-mac-arm64.dmg',
    url: '/dl/RustDesk-mac-arm64.dmg',
    platformEs: 'macOS (Apple Silicon)',
    platformEn: 'macOS (Apple Silicon)'
  },
  {
    id: 'mac_intel',
    file: 'RustDesk-mac-intel.dmg',
    url: '/dl/RustDesk-mac-intel.dmg',
    platformEs: 'macOS (Intel)',
    platformEn: 'macOS (Intel)'
  }
];
---

<section class="checksums-section" id="checksums">
  <div class="container">
    <div class="checksums-card">
      <div class="checksums-header">
        <h3 class="checksums-title">
          <span data-i18n-es>Descargas directas y verificación</span>
          <span data-i18n-en>Direct Downloads & Verification</span>
        </h3>
        <p class="checksums-subtitle" id="checksums-subtitle">
          <span data-i18n-es>
            Enlaces directos a los archivos. Las sumas SHA-256 se cargan desde el servidor de descargas; puedes comparar la de tu archivo con los comandos de abajo.
          </span>
          <span data-i18n-en>
            Direct links to the files. SHA-256 checksums are loaded from the download server; you can compare your file's with the commands below.
          </span>
        </p>
      </div>

      <div class="checksums-table-wrapper">
        <table class="checksums-table" id="checksums-table">
          <thead>
            <tr>
              <th>
                <span data-i18n-es>Archivo</span>
                <span data-i18n-en>File</span>
              </th>
              <th>
                <span data-i18n-es>Plataforma</span>
                <span data-i18n-en>Platform</span>
              </th>
              <!-- Hash column is hidden until real hashes are fetched from /dl/manifest.json -->
              <th class="hash-col hidden" id="hash-col-header">
                <span data-i18n-es>Hash SHA-256</span>
                <span data-i18n-en>SHA-256 Hash</span>
              </th>
            </tr>
          </thead>
          <tbody>
            {FALLBACK_ITEMS.map((item) => (
              <tr>
                <td class="file-name">
                  <div class="file-name-group">
                    <a href={item.url} class="download-table-link" id={`download-link-${item.id}`} download>
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                        <polyline points="7 10 12 15 17 10"></polyline>
                        <line x1="12" y1="15" x2="12" y2="3"></line>
                      </svg>
                      <span>{item.file}</span>
                    </a>
                    <span class="file-version-tag hidden" id={`file-version-${item.id}`}></span>
                  </div>
                </td>
                <td class="platform-cell">
                  <span data-i18n-es>{item.platformEs}</span>
                  <span data-i18n-en>{item.platformEn}</span>
                </td>
                <td class="hash-col hidden" id={`hash-val-${item.id}`}></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="verify-help hidden" id="verify-help">
        <p>
          <span data-i18n-es>Para calcular la suma de tu archivo:</span>
          <span data-i18n-en>To compute your file's checksum:</span>
        </p>
        <ul>
          <li>
            <span data-i18n-es>Windows (PowerShell):</span>
            <span data-i18n-en>Windows (PowerShell):</span>
            <code>Get-FileHash $HOME\Downloads\RustDesk-win64.exe</code>
          </li>
          <li>
            <span data-i18n-es>macOS (Terminal):</span>
            <span data-i18n-en>macOS (Terminal):</span>
            <code>shasum -a 256 ~/Downloads/RustDesk-mac-*.dmg</code>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .checksums-section {
    padding: 2.5rem 0 3.5rem;
  }

  .checksums-card {
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.5rem;
  }

  .checksums-header {
    margin-bottom: 1.25rem;
  }

  .checksums-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 0.25rem;
  }

  .checksums-subtitle {
    font-size: 0.8125rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .checksums-table-wrapper {
    overflow-x: auto;
  }

  .checksums-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.8125rem;
    text-align: left;
  }

  .checksums-table th {
    padding: 0.625rem 0.75rem;
    border-bottom: 1px solid var(--border);
    color: var(--text-muted);
    font-weight: 500;
    white-space: nowrap;
  }

  .checksums-table td {
    padding: 0.625rem 0.75rem;
    border-bottom: 1px solid var(--border-subtle);
    color: var(--text-secondary);
  }

  .checksums-table tr:last-child td {
    border-bottom: none;
  }

  .file-name-group {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .download-table-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--accent);
    font-weight: 500;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .download-table-link:hover {
    text-decoration: underline;
    color: var(--accent-hover);
  }

  .file-version-tag {
    font-size: 0.6875rem;
    font-weight: 600;
    font-family: var(--font-mono);
    padding: 0.0625rem 0.3125rem;
    border-radius: 4px;
    background-color: var(--bg-subtle);
    border: 1px solid var(--border);
    color: var(--text-secondary);
  }

  :global(.hash-code) {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-secondary);
    background-color: var(--code-bg);
    padding: 0.125rem 0.375rem;
    border-radius: 4px;
    word-break: break-all;
    display: inline-block;
  }

  .verify-help {
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-subtle);
    font-size: 0.8125rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .verify-help ul {
    list-style: none;
    margin-top: 0.375rem;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .verify-help code {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    background-color: var(--code-bg);
    color: var(--text-secondary);
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    display: block;
    margin-top: 0.25rem;
    overflow-x: auto;
    white-space: nowrap;
  }

  .hidden {
    display: none !important;
  }

  /* Phones: one card per file instead of a table that has to scroll sideways. */
  @media (max-width: 640px) {
    .checksums-card {
      padding: 1.25rem 1rem;
    }

    .checksums-table thead {
      display: none;
    }

    .checksums-table,
    .checksums-table tbody,
    .checksums-table tr,
    .checksums-table td {
      display: block;
      width: 100%;
    }

    .checksums-table tr {
      padding: 0.75rem 0;
      border-bottom: 1px solid var(--border-subtle);
    }

    .checksums-table tr:last-child {
      border-bottom: none;
    }

    .checksums-table td {
      padding: 0.125rem 0;
      border-bottom: none;
    }

    .platform-cell {
      font-size: 0.75rem;
      color: var(--text-muted);
    }
  }
</style>

<script>
  const IDS = ['windows', 'mac_arm64', 'mac_intel'] as const;

  function safeUrl(url: unknown): string | undefined {
    if (typeof url !== 'string') return undefined;
    return url.startsWith('/dl/') || url.startsWith('https://dl.davepinto.dev/') ? url : undefined;
  }

  function renderChecksums(manifest: any) {
    if (!manifest || typeof manifest !== 'object') return;

    let hasAnyHash = false;

    IDS.forEach((id) => {
      const item = manifest[id];
      const hashCell = document.getElementById(`hash-val-${id}`);
      const linkEl = document.getElementById(`download-link-${id}`) as HTMLAnchorElement | null;
      const verEl = document.getElementById(`file-version-${id}`);

      const url = safeUrl(item?.url);
      if (url && linkEl) linkEl.href = url;

      const version = item?.version || manifest.version;
      if (typeof version === 'string' && version && verEl) {
        verEl.textContent = `v${version}`;
        verEl.classList.remove('hidden');
      }

      // Only show something that really is a SHA-256; never inject manifest text as HTML.
      const sha = typeof item?.sha256 === 'string' ? item.sha256.trim().toLowerCase() : '';
      if (/^[0-9a-f]{64}$/.test(sha) && hashCell) {
        hasAnyHash = true;
        const code = document.createElement('code');
        code.className = 'hash-code';
        code.textContent = sha;
        hashCell.replaceChildren(code);
      }
    });

    if (hasAnyHash) {
      document.querySelectorAll('.hash-col, #verify-help').forEach((el) => el.classList.remove('hidden'));
    }
  }

  // Hero owns the fetch. If it finished before this script ran, the result is on window.
  if ((window as any).__MANIFEST__) {
    renderChecksums((window as any).__MANIFEST__);
  }

  document.addEventListener('manifest-loaded', ((e: CustomEvent) => {
    renderChecksums(e.detail?.manifest);
  }) as EventListener);
</script>
